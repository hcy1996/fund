# ===== 基础（本地默认）=====
DATABASE_URL="mysql://root:password@127.0.0.1:3307/fund_estimator"
NEXTAUTH_SECRET="<replace-with-random-secret>"
NEXTAUTH_URL="http://localhost:3000"
CRON_SECRET="<replace-with-random-secret>"

# ===== 行情/快照（可选）=====
# 行情并发拉取限制（默认 3）
# FUND_QUOTE_CONCURRENCY_LIMIT=6
# 东财请求超时（毫秒，默认 3000~4500）
# FUND_PROVIDER_TIMEOUT_MS=3500
# 基金搜索请求超时（毫秒，默认 3000）
# FUND_SEARCH_TIMEOUT_MS=3000
# 行情本地缓存 TTL（毫秒，默认 15000）
# FUND_QUOTE_LOCAL_CACHE_TTL_MS=15000
# 是否写入 FundSnapshot（1 开启，默认关闭）
# ENABLE_FUND_SNAPSHOT=0

# ===== 截图识别（至少配置一套）=====
# 视觉模型优先级：auto | openai | dashscope | volc | ark
VISION_PROVIDER="auto"

# OpenAI
OPENAI_API_KEY=""
# OPENAI_VISION_MODEL="gpt-4o-mini"

# DashScope（阿里云百炼）
DASHSCOPE_API_KEY=""
# DASHSCOPE_VL_MODEL="qwen3-vl-flash-2026-01-22"
# DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com"

# 火山方舟（豆包，多模态 OpenAI 兼容）
ARK_API_KEY=""
ARK_ENDPOINT_ID=""
# ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# ARK_RESPONSE_JSON=1
