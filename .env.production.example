# 线上（Vercel）环境变量模板
# 这些变量应配置在 Vercel Project Settings -> Environment Variables

DATABASE_URL="mysql://<user>:<password>@<host>:<port>/<db>"
NEXTAUTH_SECRET="<generate-a-random-secret>"
NEXTAUTH_URL="https://your-domain.vercel.app"
CRON_SECRET="<generate-a-random-secret>"

# 行情/快照（可选）
# FUND_QUOTE_CONCURRENCY_LIMIT=6
# FUND_QUOTE_LOCAL_CACHE_TTL_MS=15000
# FUND_QUOTE_LOCAL_CACHE_MAX_SIZE=1000
# FUND_QUOTE_LATEST_NAV_SOFT_TIMEOUT_MS=800
# ENABLE_FUND_SNAPSHOT=0
# FUND_PROVIDER_TIMEOUT_MS=3500
# FUND_SEARCH_TIMEOUT_MS=3000

# 截图识别：至少配置一套（建议显式指定）
VISION_PROVIDER="auto"

# OpenAI
OPENAI_API_KEY=""
# OPENAI_VISION_MODEL="gpt-4o-mini"

# DashScope
# DASHSCOPE_API_KEY=""
# DASHSCOPE_VL_MODEL="qwen3-vl-flash-2026-01-22"
# DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com"

# 火山方舟
# ARK_API_KEY=""
# ARK_ENDPOINT_ID=""
# ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# ARK_RESPONSE_JSON=1
